      "width": "third"
    },
    {
      "name": "最近 review 日",
      "label": "最近 review 日",
      "type": "date",
      "width": "half"
    },
    {
      "name": "使用次数",
      "label": "使用次数",
      "type": "number",
      "width": "half"
    },
    {
      "name": "关联域",
      "label": "关联域",
      "type": "text",
      "width": "half"
    }
  ]
}