    {
      "name": "Owner",
      "label": "Owner",
      "type": "text",
      "width": "third"
    },
    {
      "name": "来源",
      "label": "来源",
      "type": "text",
      "width": "half"
    },
    {
      "name": "入库日",
      "label": "入库日",
      "type": "date",
      "width": "half"
    },
    {
      "name": "版本",
      "label": "版本",
      "type": "text",
